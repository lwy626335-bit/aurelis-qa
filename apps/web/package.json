    "@vitejs/plugin-rsc": "^0.5.34",
    "axe-core": "^4.13.0",
    "eslint": "9.39.5",
    "eslint-config-next": "^16.3.1",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.26",
