    "clsx": "^2.1.1",
    "geist": "^1.7.2",
    "gsap": "^3.15.0",
    "next": "^16.3.1",
    "playwright": "1.62.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-server-dom-webpack": "^19.2.8",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
